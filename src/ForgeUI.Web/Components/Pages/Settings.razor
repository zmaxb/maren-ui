@page "/Settings"

<PageTitle>Settings</PageTitle>

<MudContainer MaxWidth="MaxWidth.ExtraLarge"
              Class="py-8">

    <MudStack Spacing="6">

        <MudStack Spacing="1">
            <MudText Typo="Typo.h3">
                Settings
            </MudText>

            <MudText Typo="Typo.subtitle1"
                     Color="Color.Secondary">
                Configure application appearance and behavior
            </MudText>
        </MudStack>

        <MudDivider/>

        <MudForm Model="_settings"
                 @ref="_form"
                 ValidationDelay="0">

            <MudGrid Spacing="3">

                <MudItem xs="12">
                    <MudPaper Class="pa-6"
                              Elevation="1">

                        <MudStack Spacing="4">

                            <MudStack Row
                                      AlignItems="AlignItems.Center"
                                      Spacing="1">

                                <MudIcon Icon="@Icons.Material.Outlined.Palette"
                                         Size="Size.Small"
                                         Color="Color.Primary"/>

                                <MudText Typo="Typo.h5">
                                    Appearance
                                </MudText>

                            </MudStack>

                            <MudText Typo="Typo.body2"
                                     Color="Color.Secondary">
                                Choose the visual theme used throughout the application.
                            </MudText>

                            <MudSelect T="AppTheme"
                                       Label="Theme"
                                       Variant="Variant.Outlined"
                                       FullWidth
                                       @bind-Value="_settings.Theme">

                                <MudSelectItem Value="AppTheme.Asphalt">
                                    Asphalt
                                </MudSelectItem>

                                <MudSelectItem Value="AppTheme.Slate">
                                    Slate
                                </MudSelectItem>

                            </MudSelect>

                        </MudStack>

                    </MudPaper>
                </MudItem>

                <MudItem xs="12">
                    <MudStack Row
                              Wrap="Wrap.Wrap"
                              Justify="Justify.FlexEnd"
                              Spacing="2">

                        <MudButton Variant="Variant.Filled"
                                   Color="Color.Primary"
                                   StartIcon="@Icons.Material.Outlined.Save"
                                   OnClick="@SaveAsync">
                            Save changes
                        </MudButton>

                    </MudStack>
                </MudItem>

            </MudGrid>

        </MudForm>

    </MudStack>

</MudContainer>

@code
{
    private MudForm _form = null!;

    private ApplicationSettings _settings = new();

    protected override void OnInitialized()
    {
        _settings = new ApplicationSettings
        {
            Theme = SettingsProvider.Settings.Theme
        };
    }

    private async Task SaveAsync()
    {
        if (!_form.IsValid)
        {
            return;
        }

        await SettingsProvider.UpdateAsync(_settings);
    }
}