@page "/user-settings"

<PageTitle>User Settings</PageTitle>

<MudContainer MaxWidth="MaxWidth.ExtraLarge"
              Class="py-8">

    <MudStack Spacing="6">

        <MudStack Spacing="1">

            <MudText Typo="Typo.h3">
                User Settings
            </MudText>

            <MudText Typo="Typo.subtitle1"
                     Color="Color.Secondary">
                Configure your personal application preferences
            </MudText>

        </MudStack>

        <MudDivider/>

        <MudPaper Class="pa-8"
                  Elevation="1">

            <MudStack AlignItems="AlignItems.Center"
                      Spacing="3"
                      Class="py-8">

                <MudIcon Icon="@Icons.Material.Outlined.ManageAccounts"
                         Size="Size.Large"
                         Color="Color.Primary"/>

                <MudStack AlignItems="AlignItems.Center"
                          Spacing="1">

                    <MudText Typo="Typo.h5"
                             Align="Align.Center">
                        User settings are coming soon
                    </MudText>

                    <MudText Typo="Typo.body1"
                             Color="Color.Secondary"
                             Align="Align.Center"
                             Style="max-width: 520px;">

                        This page will contain personal settings associated
                        with your account, including appearance and application
                        behavior preferences.

                    </MudText>

                </MudStack>

            </MudStack>

        </MudPaper>

    </MudStack>

</MudContainer>