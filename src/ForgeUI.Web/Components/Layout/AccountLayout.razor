@using ForgeUI.Web.Infrastructure.Themes.Providers
@inherits LayoutComponentBase

<MudThemeProvider Theme="@_theme"
                  IsDarkMode="@_isDarkMode"/>

<MudPopoverProvider/>
<MudDialogProvider/>
<MudSnackbarProvider/>

<MudLayout>

    <MudAppBar Elevation="1">

        <MudStack Row
                  AlignItems="AlignItems.Center"
                  Spacing="2">

            <MudIcon Icon="@Icons.Material.Filled.AccountCircle"
                     Color="Color.Primary"/>

            <MudText Typo="Typo.h5">
                Account
            </MudText>

        </MudStack>

        <MudSpacer/>

        <MudButton Href="/"
                   Variant="Variant.Outlined"
                   Color="Color.Primary"
                   StartIcon="@Icons.Material.Outlined.ArrowBack">
            Return to application
        </MudButton>

    </MudAppBar>

    <MudMainContent Class="pt-16 pa-4">

        <MudContainer MaxWidth="MaxWidth.Large"
                      Class="py-4">

            @Body

        </MudContainer>

    </MudMainContent>

</MudLayout>

<div id="blazor-error-ui"
     data-nosnippet>

    An unhandled error has occurred.

    <a href="."
       class="reload">
        Reload
    </a>

    <span class="dismiss">
        🗙
    </span>

</div>

@code {
    private MudTheme _theme = new();

    private bool _isDarkMode;

    protected override void OnInitialized()
    {
        ApplyTheme(SettingsProvider.Settings.Theme);
    }

    private void ApplyTheme(
        AppTheme theme)
    {
        var definition =
            ThemeProvider.GetTheme(theme);

        _isDarkMode =
            definition.MudTheme.IsDarkMode;

        _theme = new MudTheme();

        if (_isDarkMode)
        {
            _theme.PaletteDark =
                (PaletteDark)definition
                    .MudTheme
                    .Palette;
        }
        else
        {
            _theme.PaletteLight =
                (PaletteLight)definition
                    .MudTheme
                    .Palette;
        }
    }

}