@inherits LayoutComponentBase
@using ForgeUI.Web.Infrastructure.Themes.Providers
@implements IDisposable

<MudThemeProvider Theme="@_theme"
                  IsDarkMode="@IsDarkMode"/>

<MudPopoverProvider/>
<MudDialogProvider/>
<MudSnackbarProvider/>

<MudLayout>
    <MudAppBar Elevation="1">

        <div class="brand">

            <MudIcon Icon="@Icons.Material.Outlined.Construction"
                     Size="Size.Large"
                     Color="Color.Primary"/>

            <div>

                <MudStack Row="true"
                          Spacing="1"
                          AlignItems="AlignItems.Center">

                    <MudText Typo="Typo.h6">
                        Forge UI
                    </MudText>

                    <MudLink Typo="Typo.overline"
                             Color="Color.Primary">

                        Template

                    </MudLink>

                </MudStack>

            </div>

        </div>

    </MudAppBar>

    <MudDrawer id="nav-drawer"
               Variant="DrawerVariant.Mini"
               ClipMode="DrawerClipMode.Always"
               Elevation="2">

        <NavMenu/>

    </MudDrawer>

    <MudMainContent Class="pt-16 pa-4">
        @Body
    </MudMainContent>
</MudLayout>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code{

    private MudTheme? _theme;

    private bool IsDarkMode { get; set; }

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();

        await ApplyTheme(SettingsProvider.Settings.Theme);

        SettingsProvider.SettingsChanged +=
            OnSettingsChanged;
    }

    public void Dispose()
    {
        SettingsProvider.SettingsChanged -=
            OnSettingsChanged;
    }

    private async Task OnSettingsChanged(
        ApplicationSettings settings)
    {
        await ApplyTheme(settings.Theme);
    }

    private async Task ApplyTheme(
        AppTheme theme)
    {
        var definition =
            ThemeProvider.GetTheme(theme);

        IsDarkMode =
            definition.MudTheme.IsDarkMode;

        _theme = new MudTheme();

        if (IsDarkMode)
        {
            _theme.PaletteDark =
                (PaletteDark)definition
                    .MudTheme
                    .Palette;
        }
        else
        {
            _theme.PaletteLight =
                (PaletteLight)definition
                    .MudTheme
                    .Palette;
        }

        await InvokeAsync(StateHasChanged);
    }

}