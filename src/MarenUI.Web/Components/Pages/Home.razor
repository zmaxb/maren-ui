@page "/"

<PageTitle>Theme Preview</PageTitle>

<MudContainer MaxWidth="MaxWidth.False"
              Style="max-width: 2240px;"
              Class="py-8">

    <MudStack Spacing="6">

        <MudStack Spacing="1">
            <MudText Typo="Typo.h3">
                Maren UI
            </MudText>

            <MudText Typo="Typo.subtitle1"
                     Color="Color.Secondary">
                Theme preview and component showcase
            </MudText>
        </MudStack>

        <MudDivider/>

        <MudGrid Spacing="3">

            <MudItem xs="12" md="4">
                <MudPaper Class="pa-6"
                          Elevation="1">

                    <MudText Typo="Typo.h5"
                             GutterBottom>
                        Typography
                    </MudText>

                    <MudStack Spacing="2">
                        <MudText Typo="Typo.h3">
                            Page heading
                        </MudText>

                        <MudText Typo="Typo.h6">
                            Section heading
                        </MudText>

                        <MudText Typo="Typo.body1">
                            Primary body text for descriptions and application content.
                        </MudText>

                        <MudText Typo="Typo.body2"
                                 Color="Color.Secondary">
                            Secondary text for hints, metadata and supporting information.
                        </MudText>

                        <MudLink Color="Color.Primary">
                            Interactive link
                        </MudLink>

                        <MudText Typo="Typo.caption"
                                 Color="Color.Secondary">
                            Caption and metadata text
                        </MudText>
                    </MudStack>

                </MudPaper>
            </MudItem>

            <MudItem xs="12" md="8">
                <MudPaper Class="pa-6"
                          Elevation="1">

                    <MudText Typo="Typo.h5"
                             GutterBottom>
                        Color palette
                    </MudText>

                    <MudGrid Spacing="2">
                        @foreach (var color in ThemeColors)
                        {
                            <MudItem xs="6" sm="4">
                                <MudPaper Class="pa-4 d-flex flex-column justify-end"
                                          Style="@GetColorPreviewStyle(color)"
                                          Elevation="0">

                                    <MudText Typo="Typo.subtitle2">
                                        @color.Name
                                    </MudText>

                                    <MudText Typo="Typo.caption">
                                        @color.Value
                                    </MudText>

                                </MudPaper>
                            </MudItem>
                        }
                    </MudGrid>

                </MudPaper>
            </MudItem>

            <MudItem xs="12">
                <MudPaper Class="pa-6"
                          Elevation="1">

                    <MudText Typo="Typo.h5"
                             GutterBottom>
                        Surfaces and elevation
                    </MudText>

                    <MudGrid Spacing="3">
                        @for (var elevation = 0; elevation <= 3; elevation++)
                        {
                            var currentElevation = elevation;

                            <MudItem xs="12" sm="6" md="3">
                                <MudPaper Class="pa-6"
                                          Elevation="@currentElevation">

                                    <MudText Typo="Typo.subtitle1">
                                        Elevation @currentElevation
                                    </MudText>

                                    <MudText Typo="Typo.body2"
                                             Color="Color.Secondary">
                                        Surface preview
                                    </MudText>

                                </MudPaper>
                            </MudItem>
                        }
                    </MudGrid>

                </MudPaper>
            </MudItem>

            <MudItem xs="12">
                <MudPaper Class="pa-6"
                          Elevation="1">

                    <MudText Typo="Typo.h5"
                             GutterBottom>
                        Actions
                    </MudText>

                    <MudStack Row
                              Wrap="Wrap.Wrap"
                              AlignItems="AlignItems.Center"
                              Spacing="2">

                        <MudButton Variant="Variant.Filled"
                                   Color="Color.Primary">
                            Primary
                        </MudButton>

                        <MudButton Variant="Variant.Filled"
                                   Color="Color.Secondary">
                            Secondary
                        </MudButton>

                        <MudButton Variant="Variant.Outlined"
                                   Color="Color.Primary">
                            Outlined
                        </MudButton>

                        <MudButton Variant="Variant.Text"
                                   Color="Color.Primary">
                            Text
                        </MudButton>

                        <MudButton Variant="Variant.Filled"
                                   Color="Color.Success"
                                   StartIcon="@Icons.Material.Outlined.Check">
                            Confirm
                        </MudButton>

                        <MudButton Variant="Variant.Filled"
                                   Color="Color.Error"
                                   StartIcon="@Icons.Material.Outlined.Delete">
                            Delete
                        </MudButton>

                        <MudButton Variant="Variant.Filled"
                                   Disabled>
                            Disabled
                        </MudButton>

                        <MudIconButton Icon="@Icons.Material.Outlined.Settings"
                                       Color="Color.Primary"/>

                        <MudIconButton Icon="@Icons.Material.Outlined.FavoriteBorder"
                                       Color="Color.Secondary"/>

                    </MudStack>

                </MudPaper>
            </MudItem>

            <MudItem xs="12" md="6">
                <MudPaper Class="pa-6"
                          Elevation="1">

                    <MudText Typo="Typo.h5"
                             GutterBottom>
                        Form controls
                    </MudText>

                    <MudStack Spacing="3">

                        <MudTextField Label="Project name"
                                      Variant="Variant.Outlined"
                                      @bind-Value="_projectName"/>

                        <MudTextField Label="Description"
                                      Variant="Variant.Outlined"
                                      Lines="3"
                                      @bind-Value="_description"/>

                        <MudSelect T="string"
                                   Label="Environment"
                                   Variant="Variant.Outlined"
                                   @bind-Value="_environment">

                            <MudSelectItem Value="@("Development")">
                                Development
                            </MudSelectItem>

                            <MudSelectItem Value="@("Staging")">
                                Staging
                            </MudSelectItem>

                            <MudSelectItem Value="@("Production")">
                                Production
                            </MudSelectItem>

                        </MudSelect>

                        <MudStack Row
                                  Wrap="Wrap.Wrap"
                                  AlignItems="AlignItems.Center"
                                  Spacing="4">

                            <MudCheckBox T="bool"
                                         Label="Enabled"
                                         Color="Color.Primary"
                                         @bind-Value="_enabled"/>

                            <MudSwitch T="bool"
                                       Color="Color.Primary"
                                       Label="Notifications"
                                       @bind-Value="_notifications"/>

                        </MudStack>

                        <MudSlider T="int"
                                   Min="0"
                                   Max="100"
                                   Color="Color.Primary"
                                   @bind-Value="_progress"/>

                    </MudStack>

                </MudPaper>
            </MudItem>

            <MudItem xs="12" md="6">
                <MudPaper Class="pa-6"
                          Elevation="1">

                    <MudText Typo="Typo.h5"
                             GutterBottom>
                        Selection and states
                    </MudText>

                    <MudStack Spacing="4">

                        <MudStack Row
                                  Wrap="Wrap.Wrap"
                                  Spacing="1">

                            <MudChip T="string"
                                     Color="Color.Primary"
                                     Variant="Variant.Filled">
                                Primary
                            </MudChip>

                            <MudChip T="string"
                                     Color="Color.Success"
                                     Variant="Variant.Filled"
                                     Icon="@Icons.Material.Outlined.CheckCircle">
                                Active
                            </MudChip>

                            <MudChip T="string"
                                     Color="Color.Warning"
                                     Variant="Variant.Outlined">
                                Warning
                            </MudChip>

                            <MudChip T="string"
                                     Color="Color.Error"
                                     Variant="Variant.Outlined">
                                Error
                            </MudChip>

                            <MudChip T="string"
                                     Disabled>
                                Disabled
                            </MudChip>

                        </MudStack>

                        <MudRadioGroup T="string"
                                       @bind-Value="_mode">

                            <MudRadio T="string"
                                      Value="@("Simple")"
                                      Color="Color.Primary">
                                Simple
                            </MudRadio>

                            <MudRadio T="string"
                                      Value="@("Advanced")"
                                      Color="Color.Primary">
                                Advanced
                            </MudRadio>

                        </MudRadioGroup>

                        <MudRating @bind-SelectedValue="_rating"
                                   Color="Color.Warning"/>

                        <MudStack Row
                                  AlignItems="AlignItems.Center"
                                  Spacing="3">

                            <MudProgressLinear Value="@_progress"
                                               Color="Color.Primary"
                                               Rounded
                                               Class="flex-grow-1"/>

                            <MudProgressCircular Indeterminate
                                                 Color="Color.Primary"
                                                 Size="Size.Medium"/>

                        </MudStack>

                    </MudStack>

                </MudPaper>
            </MudItem>

            <MudItem xs="12">
                <MudPaper Class="pa-6"
                          Elevation="1">

                    <MudText Typo="Typo.h5"
                             GutterBottom>
                        Feedback
                    </MudText>

                    <MudGrid Spacing="2">

                        <MudItem xs="12" md="6">
                            <MudAlert Severity="Severity.Info"
                                      Variant="Variant.Outlined">
                                Information message with additional context.
                            </MudAlert>
                        </MudItem>

                        <MudItem xs="12" md="6">
                            <MudAlert Severity="Severity.Success"
                                      Variant="Variant.Filled">
                                The operation completed successfully.
                            </MudAlert>
                        </MudItem>

                        <MudItem xs="12" md="6">
                            <MudAlert Severity="Severity.Warning"
                                      Variant="Variant.Outlined">
                                Review the configuration before continuing.
                            </MudAlert>
                        </MudItem>

                        <MudItem xs="12" md="6">
                            <MudAlert Severity="Severity.Error"
                                      Variant="Variant.Filled">
                                The operation could not be completed.
                            </MudAlert>
                        </MudItem>

                    </MudGrid>

                </MudPaper>
            </MudItem>

            <MudItem xs="12">
                <MudPaper Class="pa-6"
                          Elevation="1">

                    <MudStack Row
                              Wrap="Wrap.Wrap"
                              AlignItems="AlignItems.Center"
                              Justify="Justify.SpaceBetween"
                              Spacing="2"
                              Class="mb-4">

                        <MudStack Spacing="0">
                            <MudText Typo="Typo.h5">
                                Data display
                            </MudText>

                            <MudText Typo="Typo.body2"
                                     Color="Color.Secondary">
                                Table, status indicators and row actions
                            </MudText>
                        </MudStack>

                        <MudButton Variant="Variant.Outlined"
                                   Color="Color.Primary"
                                   StartIcon="@Icons.Material.Outlined.Add">
                            Add item
                        </MudButton>

                    </MudStack>

                    <MudTable Items="@Items"
                              Hover
                              Striped
                              Bordered>

                        <HeaderContent>
                            <MudTh>Name</MudTh>
                            <MudTh>Status</MudTh>
                            <MudTh>Environment</MudTh>
                            <MudTh Class="text-end">
                                Actions
                            </MudTh>
                        </HeaderContent>

                        <RowTemplate>
                            <MudTd DataLabel="Name">
                                @context.Name
                            </MudTd>

                            <MudTd DataLabel="Status">
                                <MudChip T="string"
                                         Size="Size.Small"
                                         Color="@GetStatusColor(context.Status)"
                                         Variant="Variant.Filled">
                                    @context.Status
                                </MudChip>
                            </MudTd>

                            <MudTd DataLabel="Environment">
                                @context.Environment
                            </MudTd>

                            <MudTd DataLabel="Actions"
                                   Class="text-end">

                                <MudIconButton Icon="@Icons.Material.Outlined.Edit"
                                               Size="Size.Small"/>

                                <MudIconButton Icon="@Icons.Material.Outlined.Delete"
                                               Size="Size.Small"
                                               Color="Color.Error"/>

                            </MudTd>
                        </RowTemplate>

                    </MudTable>

                </MudPaper>
            </MudItem>

        </MudGrid>

    </MudStack>

</MudContainer>

@code {
    private string _projectName = "Maren UI";

    private string _description =
        "Reusable application template powered by MudBlazor.";

    private string _environment = "Development";

    private string _mode = "Simple";

    private bool _enabled = true;

    private bool _notifications = true;

    private int _progress = 68;

    private int _rating = 4;

    private static readonly IReadOnlyList<ThemeColorPreview> ThemeColors =
    [
        new(
            "Primary",
            "var(--mud-palette-primary)",
            "#FFFFFF"),

        new(
            "Secondary",
            "var(--mud-palette-secondary)",
            "#FFFFFF"),

        new(
            "Success",
            "var(--mud-palette-success)",
            "#FFFFFF"),

        new(
            "Warning",
            "var(--mud-palette-warning)",
            "var(--mud-palette-text-primary)"),

        new(
            "Error",
            "var(--mud-palette-error)",
            "#FFFFFF"),

        new(
            "Info",
            "var(--mud-palette-info)",
            "#FFFFFF"),

        new(
            "Background",
            "var(--mud-palette-background)",
            "var(--mud-palette-text-primary)",
            true),

        new(
            "Surface",
            "var(--mud-palette-surface)",
            "var(--mud-palette-text-primary)",
            true),

        new(
            "Drawer",
            "var(--mud-palette-drawer-background)",
            "var(--mud-palette-drawer-text)")
    ];

    private static readonly IReadOnlyList<PreviewItem> Items =
    [
        new(
            "Maren UI",
            "Active",
            "Development"),

        new(
            "Identity",
            "Pending",
            "Staging"),

        new(
            "Settings",
            "Failed",
            "Production")
    ];

    private static string GetColorPreviewStyle(
        ThemeColorPreview color)
    {
        var border = color.ShowBorder
            ? "border: 1px solid var(--mud-palette-lines-default);"
            : string.Empty;

        return
            $"height: 96px;" +
            $"background: {color.Value};" +
            $"color: {color.TextColor};" +
            border;
    }

    private static Color GetStatusColor(
        string status)
    {
        return status switch
        {
            "Active" => Color.Success,
            "Pending" => Color.Warning,
            "Failed" => Color.Error,
            _ => Color.Default
        };
    }

    private sealed record ThemeColorPreview(
        string Name,
        string Value,
        string TextColor,
        bool ShowBorder = false);

    private sealed record PreviewItem(
        string Name,
        string Status,
        string Environment);

}
